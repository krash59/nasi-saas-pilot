# Copy to `.env.local` — never commit secrets.

# Clerk (invite-only / restricted mode in Clerk Dashboard — DIR §4.3)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional issuer-provided public PEM for offline JWT verification. Refresh it
# when rotating the Clerk signing key; never disable signature/expiry checks.
CLERK_JWT_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in

# Neon PostgreSQL — use non-superuser role without BYPASSRLS for app runtime (DIR §4.2)
DATABASE_URL=

# Optional: separate migration role with DDL rights (not used at runtime)
DATABASE_MIGRATE_URL=

# Design assistant. OpenAI is the default; use the deterministic stub only for local development.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
NASI_DESIGN_ASSISTANT_MODE=

# Optional synthetic pilot integrations. Disabled until explicitly configured.
# Keep actual keys in private local configuration, never audit evidence.
NASI_PROVIDER_MODE=disabled
NASI_PILOT_CUSTOMER_IDS=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
# Stripe subscription/customer bindings are operator-provisioned in
# pilot_billing_accounts, never accepted from a public HTTP request.
